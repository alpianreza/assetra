# Runtime
NODE_ENV=development
PORT=3000
# Backward-compatible alias; PORT takes precedence when both are set.
API_PORT=3000
APP_NAME=Assetra
APP_VERSION=0.0.1

# Public Assetra URL used by generated QR links.
# Development: Vite URL. Production single-server: NestJS public URL.
APP_URL=http://localhost:5173
# Backward-compatible alias for existing installations.
FRONTEND_URL=http://localhost:5173

# Optional comma-separated cross-origin allowlist.
# Leave empty for same-origin production.
CORS_ORIGIN=http://localhost:5173

# Omit to default to true in production and false in development.
# Set false only for trusted HTTP LAN deployments without TLS.
COOKIE_SECURE=false

# Reserved deployment secret. Current authentication remains an opaque,
# database-backed session cookie and does not store JWT in localStorage.
SESSION_SECRET=replace-with-a-long-random-production-secret

DATABASE_URL=mysql://root:@localhost:3306/assetra_dev
